---
import ThemeToggle from "./ThemeToggle.astro";
const pathname = Astro.url.pathname.replace(/\.html$/, "");
const links = [
  { href: "/races", label: "Races" },
  { href: "/courses", label: "Courses" },
  { href: "/stats", label: "Stats" },
];
---

<header id="site-header" class="sticky top-0 z-50 bg-surface/95 backdrop-blur-sm border-b border-line">
  <div class="max-w-6xl mx-auto px-4 min-h-18 py-3 flex flex-wrap items-center gap-3 sm:gap-6">
    <a href="/" class="brand mr-auto" aria-label="TriTimes home"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>TriTimes</a>

    <nav class="hidden sm:flex items-center gap-6" aria-label="Main navigation">
      {links.map((link) => (
        <a href={link.href} aria-current={pathname === link.href || pathname.startsWith(`${link.href}/`) ? "page" : undefined}
          class={`text-sm py-2 transition-colors ${pathname === link.href || pathname.startsWith(`${link.href}/`) ? "text-accent font-semibold" : "text-secondary hover:text-foreground"}`}>{link.label}</a>
      ))}
    </nav>

    <button
      type="button"
      data-open-search
      class="hidden md:flex items-center gap-2 text-sm text-secondary hover:text-foreground transition-colors border border-line rounded-xl px-3 min-h-11 hover:border-strong"
      aria-label="Search athletes"
    >
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35" stroke-linecap="round"></path>
      </svg>
      <span>Search</span>
      <kbd data-shortcut class="text-xs border border-strong rounded px-1.5 py-0.5 text-muted font-mono">Ctrl+K</kbd>
    </button>
    <button
      type="button"
      data-open-search
      class="md:hidden icon-button"
      aria-label="Search athletes"
    >
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35" stroke-linecap="round"></path>
      </svg>
    </button>

    <ThemeToggle />

    <button
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="sm:hidden icon-button"
      aria-label="Toggle menu"
    >
      <svg data-icon-open width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="5" x2="17" y2="5"></line>
        <line x1="3" y1="10" x2="17" y2="10"></line>
        <line x1="3" y1="15" x2="17" y2="15"></line>
      </svg>
      <svg data-icon-close class="hidden" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="4" y1="4" x2="16" y2="16"></line>
        <line x1="16" y1="4" x2="4" y2="16"></line>
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" aria-label="Mobile navigation" data-mobile-menu class="hidden sm:hidden border-t border-line bg-surface">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={pathname === link.href ? "page" : undefined}
          class={`block px-4 py-3 text-base transition-colors ${pathname === link.href ? "text-foreground bg-subtle/50" : "text-secondary hover:text-foreground hover:bg-subtle/30"}`}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const header = document.getElementById("site-header")!;
  const toggle = header.querySelector<HTMLButtonElement>("[data-menu-toggle]")!;
  const menu = header.querySelector<HTMLElement>("[data-mobile-menu]")!;

  if (navigator.platform.toUpperCase().includes("MAC")) {
    header.querySelector("[data-shortcut]")!.textContent = "\u2318K";
  }

  function onKeyDown(e: KeyboardEvent) {
    if (e.key === "Escape") setMenu(false);
  }
  function onPointerDown(e: PointerEvent) {
    if (e.target instanceof Node && !header.contains(e.target)) setMenu(false);
  }
  function setMenu(open: boolean) {
    menu.classList.toggle("hidden", !open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.querySelector("[data-icon-open]")!.classList.toggle("hidden", open);
    toggle.querySelector("[data-icon-close]")!.classList.toggle("hidden", !open);
    document.body.style.overflow = open ? "hidden" : "";
    if (open) {
      document.addEventListener("keydown", onKeyDown);
      document.addEventListener("pointerdown", onPointerDown);
    } else {
      document.removeEventListener("keydown", onKeyDown);
      document.removeEventListener("pointerdown", onPointerDown);
    }
  }
  toggle.addEventListener("click", () => setMenu(menu.classList.contains("hidden")));

  // The search palette (and Preact) load only when first opened.
  let palette: Promise<{ openPalette: () => void }> | null = null;
  function openPalette() {
    palette ??= import("./palette-mount");
    palette.then((m) => m.openPalette());
  }
  header.querySelectorAll("[data-open-search]").forEach((b) => b.addEventListener("click", openPalette));
  document.addEventListener("keydown", (e) => {
    if (e.key === "k" && (e.metaKey || e.ctrlKey) && !palette) {
      e.preventDefault();
      openPalette();
    }
  });
</script>
