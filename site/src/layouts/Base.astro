---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE_URL } from "@/lib/site";
import { organizationJsonLd } from "@/lib/organization";

interface Props {
  /** Page title; the site name is appended. Omit for the default title. */
  title?: string;
  description?: string;
  /** Canonical path, e.g. "/races". */
  canonical?: string;
  /** JSON-LD object(s) to embed. */
  jsonLd?: unknown;
  noindex?: boolean;
}

const DEFAULT_TITLE = "TriTimes — IRONMAN & 70.3 Triathlon Results";
const DEFAULT_DESCRIPTION =
  "Look up IRONMAN and IRONMAN 70.3 race results with full-field time distributions. See your percentile for swim, bike, run, and overall across 1,400+ races since 2002.";

const { title, description = DEFAULT_DESCRIPTION, canonical, jsonLd, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | TriTimes` : DEFAULT_TITLE;
const ogTitle = title ?? DEFAULT_TITLE;
const ogUrl = canonical ? `${SITE_URL}${canonical}` : SITE_URL;
const googleVerification = import.meta.env.GOOGLE_SITE_VERIFICATION;
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
// Escape "<" so data in JSON-LD can never close the script tag early.
const jsonLdHtml = JSON.stringify([organizationJsonLd(import.meta.env.PUBLIC_CONTACT_EMAIL), ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])]).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Deliberately default to light, even on a device that prefers dark mode.
      // Restore only an explicit choice, before CSS/body paint to avoid flashing.
      try {
        document.documentElement.dataset.theme = localStorage.getItem("tritimes-theme") === "dark" ? "dark" : "light";
      } catch { /* The light default also works without storage or JavaScript. */ }
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={`${SITE_URL}${canonical}`} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content="TriTimes" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${SITE_URL}/og.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    <link rel="icon" href="/icon.png" type="image/png" />
    <slot name="head" />
    {jsonLdHtml && <script type="application/ld+json" set:html={jsonLdHtml} />}
  </head>
  <body class="antialiased bg-[var(--background)] min-h-dvh flex flex-col">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <slot />
    <Footer />
    {
      beaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: beaconToken })}
        />
      )
    }
  </body>
</html>
