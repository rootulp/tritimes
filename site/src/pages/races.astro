---
import Base from "@/layouts/Base.astro";
import { getRaces } from "@/lib/build-cache";
import { getCountryFlag } from "@/lib/flags";
import { getRaceLocation } from "@/lib/raceLocation";

const races = getRaces();
const totalResults = races.reduce((sum, r) => sum + r.finishers, 0);
const years = [...new Set(races.map((r) => r.date.slice(0, 4)))].sort().reverse();
const normalize = (text: string) => text.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
const formatDate = (iso: string) =>
  new Date(iso + "T00:00:00").toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
const cleanRaceName = (name: string) => name.replace(/^IRONMAN\s+70\.3\s+/i, "").replace(/^IRONMAN\s+/i, "");
const btnBase = "px-4 py-2 rounded-full text-sm font-medium";
const btnActive = `${btnBase} bg-selected text-foreground ring-1 ring-line`;
const btnIdle = `${btnBase} text-secondary hover:text-foreground hover:bg-subtle transition-colors`;
---

<Base
  title="All IRONMAN & 70.3 Races"
  description={`Browse ${races.length.toLocaleString("en-US")} IRONMAN and IRONMAN 70.3 races with ${totalResults.toLocaleString("en-US")} finisher results. Filter by distance and year, then dive into time distributions for any race.`}
  canonical="/races"
>
  <main id="main-content" class="max-w-6xl w-full mx-auto px-4 py-8">
    <header class="page-intro"><p class="eyebrow">The race archive</p><h1 class="text-3xl sm:text-4xl font-bold text-foreground">All Races</h1><p class="text-secondary">Find your finish line. Explore results by event, distance, and year.</p></header>

    <div class="filter-panel flex flex-wrap items-center gap-x-6 gap-y-3 mb-6" id="race-filters" data-active={btnActive} data-idle={btnIdle}>
      <div class="flex items-center gap-2">
        <span class="text-xs font-medium text-muted uppercase tracking-wider mr-1">Distance</span>
        {
          ["All", "70.3", "140.6"].map((d) => (
            <button type="button" data-distance={d} aria-pressed={d === "All"} class={d === "All" ? btnActive : btnIdle}>
              {d}
            </button>
          ))
        }
      </div>

      <div class="flex items-center gap-2">
        <span class="text-xs font-medium text-muted uppercase tracking-wider mr-1">Year</span>
        <select
          id="race-year"
          aria-label="Year"
          class="px-4 py-2 rounded-full text-sm font-medium bg-selected text-foreground ring-1 ring-line border-none appearance-none cursor-pointer pr-7 bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2212%22%20height%3D%2212%22%20viewBox%3D%220%200%2012%2012%22%3E%3Cpath%20fill%3D%22%239ca3af%22%20d%3D%22M3%205l3%203%203-3%22%2F%3E%3C%2Fsvg%3E')] bg-[length:12px] bg-[right_8px_center] bg-no-repeat"
        >
          <option value="All" class="bg-surface text-foreground">All</option>
          {years.map((y) => <option value={y} class="bg-surface text-foreground">{y}</option>)}
        </select>
      </div>

      <div class="flex items-center gap-2">
        <label for="race-search" class="text-xs font-medium text-muted uppercase tracking-wider mr-1">Search</label>
        <input
          id="race-search"
          type="search"
          placeholder="Name or location"
          autocomplete="off"
          class="px-4 py-2 rounded-full text-sm font-medium bg-selected text-foreground ring-1 ring-line border-none placeholder:text-muted focus:outline-none focus:ring-accent w-56"
        />
      </div>
    </div>

    <p class="text-sm text-muted mb-4">
      Showing <span id="race-count">{races.length}</span> of {races.length} races
    </p>

    <div id="race-empty" class="py-12 text-center hidden">
      <p class="text-secondary">No races match your filters.</p>
      <button
        type="button"
        id="race-clear"
        class="mt-3 px-4 py-2 rounded-full text-sm font-medium text-secondary hover:text-foreground hover:bg-subtle ring-1 ring-line transition-colors"
      >
        Clear filters
      </button>
    </div>

    <div id="race-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {
        races.map((race) => {
          const location = getRaceLocation(race);
          const flag = location ? getCountryFlag(location) : "";
          return (
            <a
              href={`/race/${race.slug}`}
              data-distance={race.slug.startsWith("im703-") ? "70.3" : "140.6"}
              data-year={race.date.slice(0, 4)}
              data-q={`${normalize(race.name)}\n${normalize(race.location ?? "")}`}
              class="group block p-5 border border-line/80 rounded-lg bg-surface transition-colors duration-200 hover:border-strong hover:bg-subtle/80 [content-visibility:auto] [contain-intrinsic-size:auto_150px]"
            >
              <div class="flex items-start justify-between gap-3">
                <h2 class="text-lg font-semibold text-foreground group-hover:text-accent transition-colors leading-tight">
                  {cleanRaceName(race.name)}
                </h2>
                <span class="shrink-0 px-2 py-0.5 rounded-full text-xs font-medium bg-subtle text-secondary">
                  {race.slug.startsWith("im703-") ? "70.3" : "140.6"}
                </span>
              </div>
              <p class="text-sm text-secondary mt-2">
                {flag && <span class="mr-1.5">{flag}</span>}
                {location}
              </p>
              <div class="flex items-center gap-2 mt-3 text-xs text-muted">
                <span>{formatDate(race.date)}</span>
                <span class="text-muted">&middot;</span>
                <span>{race.finishers.toLocaleString("en-US")} finishers</span>
              </div>
            </a>
          );
        })
      }
    </div>
  </main>
</Base>

<script>
  import { filtersToQueryString, parseFiltersFromParams } from "@/lib/races-url";

  const filters = document.getElementById("race-filters")!;
  const yearSelect = document.getElementById("race-year") as HTMLSelectElement;
  const search = document.getElementById("race-search") as HTMLInputElement;
  const cards = [...document.querySelectorAll<HTMLAnchorElement>("#race-grid > a")];
  const distanceButtons = [...filters.querySelectorAll<HTMLButtonElement>("button[data-distance]")];
  const normalize = (text: string) => text.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();

  // Seed from the URL so shared links open pre-filtered and Back restores the view.
  const state = parseFiltersFromParams(new URLSearchParams(location.search));
  if (![...yearSelect.options].some((o) => o.value === state.year)) state.year = "All";

  function apply() {
    const q = normalize(state.query.trim());
    let shown = 0;
    for (const card of cards) {
      const visible =
        (state.distance === "All" || card.dataset.distance === state.distance) &&
        (state.year === "All" || card.dataset.year === state.year) &&
        (!q || card.dataset.q!.split("\n").some((field) => field.includes(q)));
      card.hidden = !visible;
      if (visible) shown++;
    }
    document.getElementById("race-count")!.textContent = String(shown);
    document.getElementById("race-empty")!.classList.toggle("hidden", shown > 0);
    for (const b of distanceButtons) {
      b.className = b.dataset.distance === state.distance ? filters.dataset.active! : filters.dataset.idle!;
      b.setAttribute("aria-pressed", String(b.dataset.distance === state.distance));
    }
    yearSelect.value = state.year;
    if (search.value !== state.query) search.value = state.query;
    const qs = filtersToQueryString(state);
    history.replaceState(history.state, "", qs ? `${location.pathname}?${qs}` : location.pathname);
  }

  for (const b of distanceButtons) {
    b.addEventListener("click", () => {
      state.distance = b.dataset.distance!;
      apply();
    });
  }
  yearSelect.addEventListener("change", () => {
    state.year = yearSelect.value;
    apply();
  });
  search.addEventListener("input", () => {
    state.query = search.value;
    apply();
  });
  document.getElementById("race-clear")!.addEventListener("click", () => {
    Object.assign(state, { distance: "All", year: "All", query: "" });
    apply();
  });
  if (location.search) apply();
</script>
