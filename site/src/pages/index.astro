---
import Base from "@/layouts/Base.astro";
import GlobalSearchBar from "@/components/GlobalSearchBar";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "TriTimes",
  url: "https://tritimes.org",
  description:
    "IRONMAN and IRONMAN 70.3 race results with full-field time distributions and percentiles for swim, bike, and run.",
};
---

<Base jsonLd={jsonLd}>
  <main class="flex-1">
    <section class="relative">
      <div class="absolute inset-0 bg-gradient-to-br from-blue-950 via-[#0a0a0a] to-gray-900"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(59,130,246,0.15),transparent_60%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,rgba(168,85,247,0.08),transparent_50%)]"></div>

      <div class="relative z-10 flex flex-col items-center justify-center text-center px-4 pt-28 pb-20">
        <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold text-white tracking-tight mb-4">
          Race. Analyze.{" "}
          <span class="bg-gradient-to-r from-blue-400 to-blue-500 bg-clip-text text-transparent">Improve.</span>
        </h1>
        <p class="text-lg sm:text-xl text-gray-400 max-w-xl mb-10 leading-relaxed">
          Explore your IronMan &amp; 70.3 results with full field distributions. See where you stand in swim, bike, run, and
          overall.
        </p>
        <div class="w-full max-w-lg">
          <GlobalSearchBar client:load />
        </div>
      </div>
    </section>
  </main>
</Base>
