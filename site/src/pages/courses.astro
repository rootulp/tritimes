---
import Base from "@/layouts/Base.astro";
import CourseCharts from "@/components/CourseCharts";
import { getCourseStats } from "@/lib/build-cache";

const courses = getCourseStats();
---

<Base
  title="IRONMAN & 70.3 Course Difficulty"
  description="Which IRONMAN courses are fastest? Compare IRONMAN and IRONMAN 70.3 course difficulty based on median finish times across all race editions."
  canonical="/courses"
>
  <main id="main-content" class="max-w-6xl w-full mx-auto px-4 py-8">
    <header class="page-intro">
      <p class="eyebrow">Choose your terrain</p>
      <h1 class="text-3xl font-bold text-foreground">Course Difficulty</h1>
      <p class="text-secondary mt-1">
        The 10 fastest courses per discipline, ranked by median time. Select any course to see all of its races.
      </p>
    </header>
    <CourseCharts client:load courses={courses} />
  </main>
</Base>
