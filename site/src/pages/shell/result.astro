---
// Served (via public/_redirects) for every /race/<slug>/result/<id>; the
// island reads the URL, loads that race's data file, and renders the result.
import Base from "@/layouts/Base.astro";
import ResultApp from "@/components/ResultApp";
import ResultSkeleton from "@/components/ResultSkeleton";
---

<Base title="Race Result">
  <script slot="head" is:inline>
    const match = location.pathname.match(/^\/race\/([^/]+)\/result\/(\d+)\/?$/);
    if (match) {
      const link = document.createElement("link");
      link.rel = "preload"; link.as = "fetch"; link.crossOrigin = "anonymous";
      link.href = `/data/race/${match[1]}.json.gz`;
      document.head.appendChild(link);
    }
  </script>
  <noscript><p class="px-4 py-8 text-center">Enable JavaScript to view this result and its time distributions.</p></noscript>
  <ResultApp client:only="preact">
    <ResultSkeleton slot="fallback" />
  </ResultApp>
</Base>
