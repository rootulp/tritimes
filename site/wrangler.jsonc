{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tritimes",
  "compatibility_date": "2026-10-01",
  // Static assets only: no Worker script runs, so requests are free and unmetered.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": true
}
