{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tritimes",
  "compatibility_date": "2026-10-01",
  // Negotiate homepage and missing-page Markdown; preserve static asset routing.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/"],
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": true
}
