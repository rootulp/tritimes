{
  "name": "tritimes-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "data": "node --max-old-space-size=4096 --import tsx scripts/build-data.ts",
    "build": "npm run data && astro build",
    "build:pages": "astro build",
    "dev": "astro dev",
    "preview": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "e2e": "playwright test",
    "test:design": "playwright test --config playwright.design.config.ts",
    "check": "astro check",
    "verify:assets": "node --import tsx scripts/verify-assets.ts",
    "audit:prepare": "node ../scripts/gzip-csvs.js && node ../scripts/build-histograms.js && node --max-old-space-size=4096 ../scripts/build-athlete-shards.js && node ../scripts/build-search-shards.js",
    "audit": "node --max-old-space-size=6144 --import tsx scripts/audit-parity.ts",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "lighthouse": "node scripts/lighthouse.mjs",
    "performance:report": "node scripts/summarize-performance.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.1",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "preact": "^11.0.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "chrome-launcher": "1.2.2",
    "lighthouse": "12.6.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
